# Database (MongoDB Atlas connection string)
MONGODB_URL=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=bloodbridge

# Security (Generate a secure key using: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=your_secure_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend URL (Used for CORS and password reset links)
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Additional CORS Allowed Origins (Comma-separated, or * to allow all during initial setup)
# Example: https://bloodbridge.vercel.app,http://localhost:5173
CORS_ORIGINS=https://your-frontend-domain.vercel.app

# Email (SMTP for password reset notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

# Firebase Cloud Messaging (Choose Option A or Option B):
# Option A: Paste full JSON content of service account file as a string (Recommended for Render/Railway/Cloud)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"..."}
# Option B: Path to service account file on disk (For local development or Docker volume mount)
FIREBASE_CREDENTIALS_PATH=credentials/firebase-service-account.json
